generator db {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatStatus {
  ACTIVE
  DELETED
}

model uploaded_files {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id     String   @unique @db.VarChar(255)
  secure_url    String
  resource_type String   @db.VarChar(50)
  file_name     String   @db.VarChar(255)
  file_type     String   @db.VarChar(100)
  file_size     Int
  uploaded_by   Int
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_file_user")
  message_files message_files[]

  @@index([uploaded_by], map: "idx_file_user")
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_user")

  @@index([user_id], map: "idx_refresh_token_user")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model users {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(200)
  email          String           @unique @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  role_id        Int
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  files          uploaded_files[]
  refresh_tokens refresh_tokens[]
  chats          chats[]
  roles          roles            @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role")

  @@index([email], map: "idx_user_email")
  @@index([role_id], map: "idx_user_role")
}


model chats {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  title      String?     @db.VarChar(200)
  status     ChatStatus  @default(ACTIVE)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  
  users      users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages   messages[]

  @@index([user_id], map: "idx_chat_user")
  @@index([status], map: "idx_chat_status")
}

model messages {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id    String          @db.Uuid
  sender     String          @db.VarChar(10)
  content    String          @db.Text
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  
  chats      chats           @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  files      message_files[]

  @@index([chat_id], map: "idx_message_chat")
}

model message_files {
  message_id String         @db.Uuid
  file_id    String         @db.Uuid

  messages   messages       @relation(fields: [message_id], references: [id], onDelete: Cascade)
  files      uploaded_files @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@id([message_id, file_id])
}